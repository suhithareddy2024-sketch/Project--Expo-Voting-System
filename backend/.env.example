PORT=5000
MONGO_URI=mongodb://localhost:27017/decentralized_voting
JWT_SECRET=your_secure_jwt_secret
NODE_ENV=development

# Optional: Set to true if ONLY @anits.edu.in emails should be allowed to register/vote
STRICT_COLLEGE_DOMAIN=false

# ----------------------------------------------------------------------------------
# EMAIL DELIVERY CONFIGURATION
# ----------------------------------------------------------------------------------
# OPTION 1: Gmail SMTP or Custom SMTP (RECOMMENDED: Sends to ANY valid recipient)
# To use Gmail: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
# Optional custom SMTP host and port (defaults to smtp.gmail.com:465 if omitted):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# EMAIL_FROM="ANITS Expo Voting" <your_email@gmail.com>

# OPTION 2: Resend API (https://resend.com)
# NOTE: Resend's default 'onboarding@resend.dev' is a sandbox sender that ONLY permits
# delivering emails to the single email address used to register the Resend account.
# To send OTP to all voters using Resend, you MUST add and verify a custom domain
# in Resend (https://resend.com/domains) and set RESEND_FROM_EMAIL to your verified domain.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=ANITS Voter <noreply@yourdomain.com>

