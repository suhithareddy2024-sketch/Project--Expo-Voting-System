PORT=5000
MONGO_URI=mongodb://localhost:27017/decentralized_voting
JWT_SECRET=your_secure_jwt_secret
NODE_ENV=development

# -------------------------------------------------------------
# EMAIL DELIVERY CONFIGURATION
# -------------------------------------------------------------
# OPTION 1: Resend API (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=ANITS Voter <onboarding@resend.dev>

# OPTION 2: Gmail SMTP or Custom SMTP (Supports sending to ANY email)
# Create a 16-character App Password at: https://myaccount.google.com/apppasswords
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
